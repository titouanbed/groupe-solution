# ── Prise de RDV Google Calendar — variables d'environnement Vercel ──
# À renseigner dans Vercel : Project → Settings → Environment Variables.
# NE PAS committer les vraies valeurs (ce fichier n'est qu'un modèle).

# Identifiant OAuth "Application Web" (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Refresh token obtenu via : npm run oauth:setup  (voir NOTES-RDV-GoogleCalendar.md)
GOOGLE_REFRESH_TOKEN=

# Calendrier cible : "primary" ou l'ID d'un calendrier dédié
GOOGLE_CALENDAR_ID=primary

# Fuseau horaire des créneaux affichés/créés
BOOKING_TIMEZONE=Europe/Paris
